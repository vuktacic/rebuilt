# Copy this file to .env and fill in the secrets locally.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Used when GEMINI_API_KEY is empty; keep this file outside version control.
GEMINI_API_KEY_FILE=private/.gemini_token

# The bootstrap script creates this file from your approved Hugging Face token.
HF_TOKEN_FILE=private/.hf_token

# Local defaults for the demo.
OPENAI_MODEL=gpt-5.4
MANUAL_COMPARE_MODEL=gpt-6-astra
MANUAL_WRITER_MODEL=gpt-5.6-luna
MANUAL_REASONING_EFFORT=low
MANUAL_EXTRACTION_FPS=5
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FILE_TIMEOUT=180
GEMINI_POLL_SECONDS=2
GPT_TIMELINE_FPS=1
GPT_TIMELINE_WINDOW_SECONDS=20
GPT_TIMELINE_OVERLAP_SECONDS=2
RECOVERY_MAX_WINDOWS=3
RECOVERY_WINDOW_SECONDS=8
TARGETED_SAM2_ENABLED=1
REBUILT_ANALYSIS_FPS=2
REBUILT_VISION_WORKER=1
REBUILT_DATA_DIR=.data
# Bounded image-review request limits.
REBUILT_REVIEW_MAX_EVENTS=10
REBUILT_REVIEW_MAX_IMAGES=24
REBUILT_REVIEW_MAX_TEXT=500

# Local vision runtime: auto, noop, sam2, sam2-mlx, sam3-cuda (or legacy sam3), or sam3-mlx.
REBUILT_VISION_BACKEND=auto
# Fast manual reverse-tracking profile. Every source frame remains addressable in output.
SAM2_FRAME_STRIDE=2
SAM2_APPLY_POSTPROCESSING=0
SAM2_VOS_OPTIMIZED=0
# Native Apple-Silicon SAM2 profile (used only with REBUILT_VISION_BACKEND=sam2-mlx).
SAM2_MLX_MODEL_ID=avbiswas/sam2.1-hiera-small-mlx
SAM2_MLX_IMAGE_SIZE=768
SAM2_MLX_PRECOMPUTE_FEATURES=1
SAM2_MLX_FEATURE_BATCH_SIZE=4
MLX_SAM3_MODEL_DIR=.models/mlx-sam3
MLX_SAM3_MODEL_REVISION=38eced50afd50303f207c0165d0299991373c683
MLX_VLM_REVISION=a5deef1ce4b0b5ef2a01e5a02a36805878a7ee3c
# Fast local MLX profile: resize model inputs and inspect every second extracted frame.
MLX_SAM3_IMAGE_SIZE=336
MLX_SAM3_FRAME_STRIDE=2
